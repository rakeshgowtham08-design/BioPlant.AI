# ==============================================================================
# BioPlant.AI - Environment Variables
# ==============================================================================
# COPY THIS FILE TO .env.local FOR LOCAL DEVELOPMENT
# DO NOT COMMIT ACTUAL CREDENTIALS TO GITHUB
# ==============================================================================

# ========================
# FRONTEND CONFIGURATION
# ========================

# Backend API URL - Set to deployed Render backend URL in production
VITE_API_URL=http://localhost:8000

# Supabase Configuration (for frontend database access)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ========================
# BACKEND CONFIGURATION
# ========================

# Supabase Configuration (for backend database access)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Frontend URL for CORS configuration
FRONTEND_URL=http://localhost:3000

# ========================
# RENDER DEPLOYMENT NOTES
# ========================
#
# 1. Frontend Variables (configure in Render dashboard):
#    - VITE_API_URL: Will be auto-set to backend service URL
#    - VITE_SUPABASE_URL: Your Supabase project URL
#    - VITE_SUPABASE_ANON_KEY: Supabase anon/public key
#
# 2. Backend Variables (configure in Render dashboard):
#    - SUPABASE_URL: Your Supabase project URL
#    - SUPABASE_SERVICE_ROLE_KEY: Supabase service role key (keep secret!)
#    - FRONTEND_URL: Will be auto-set to frontend service URL
#
# 3. Local Development:
#    - Copy this file to .env.local
#    - Set VITE_API_URL to http://localhost:8000 when running backend locally
#    - Set FRONTEND_URL to http://localhost:3000
#    - Get Supabase credentials from your Supabase project dashboard
# ==============================================================================
